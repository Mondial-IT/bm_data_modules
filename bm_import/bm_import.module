function bm_import_help($route_name, RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.bm_import') {
    $output = '<h2>' . t('Mondial-IT Import Module') . '</h2>';
    $output .= '<p>' . t('Imports complex entity content from spreadsheet files, provides management UIs for batch definitions, and ships test tooling for handlers.') . '</p>';

    $output .= '<h3>' . t('Menus') . '</h3><ul>';
    $output .= '<li>' . t('<strong>bm_import</strong> — top-level entry under Blue Marloc » Data production that exposes every import form.') . '</li>';
    $output .= '<li>' . t('<strong>Settings</strong> — configure default sheet mappings and file handling.') . '</li>';
    $output .= '<li>' . t('<strong>Import Management</strong> — manage defined imports and execution batches.') . '</li>';
    $output .= '<li>' . t('<strong>Tests</strong> / <strong>Paragraph handler</strong> — developer tools for validating handlers and preflight checks.') . '</li>';
    $output .= '</ul>';

    $output .= '<h3>' . t('URIs') . '</h3><ul>';
    $output .= '<li>' . t('<code>@uri</code> (<code>@route</code>) — Module settings.', [
      '@uri' => '/admin/config/system/bm-import',
      '@route' => 'bm_import.settings_form',
    ]) . '</li>';
    $output .= '<li>' . t('<code>@uri</code> (<code>@route</code>) — Import management dashboard.', [
      '@uri' => '/admin/config/system/bm-import-management',
      '@route' => 'bm_import.bm_importmanagement_form',
    ]) . '</li>';
    $output .= '<li>' . t('<code>@uri</code> (<code>@route</code>) — Preflight checks / test harness.', [
      '@uri' => '/admin/config/system/bm-import-preflight',
      '@route' => 'bm_import.bm_import_panel_preflight_checks_form',
    ]) . '</li>';
    $output .= '<li>' . t('<code>@uri</code> (<code>@route</code>) — Paragraph handler test form.', [
      '@uri' => '/admin/config/system/bm-import-test/paragraph-handler',
      '@route' => 'bm_import.paragraph_handler_test_form',
    ]) . '</li>';
    $output .= '</ul>';

    return $output;
  }
  return '';
}

/**
 * @throws EntityStorageException
 */
function repairConfigError(){

  // Define the bundle and fields.
  $bundle = 'listing';
  $entity_type = 'node'; // Replace with your entity type.

  $fields = [
    'field_listing_no_of_offices' => [
      'type' => 'string_textfield',
      'settings' => [],
      'weight' => 0,
    ],
    // Add other fields as needed.
  ];

  // Rebuild view display.
  $view_display = EntityViewDisplay::create([
    'targetEntityType' => $entity_type,
    'bundle' => $bundle,
    'mode' => 'default',
    'content' => $fields,
  ])->save();

  // Rebuild form display.
  $form_display = EntityFormDisplay::create([
    'targetEntityType' => $entity_type,
    'bundle' => $bundle,
    'mode' => 'default',
    'content' => $fields,
  ])->save();
}

try {
 // repairConfigError();
} catch (EntityStorageException $e) {
  Drupal::messenger()->addError($e->getMessage());
}

/**
 * Standardizing the reporting and messages displays
 * @param $text
 *
 * @return string
 */
function traceColor($text): string {
  return '<div class="fgcolor-violet">' . $text . '</div>';
}
function warningColor($text): string {
  return '<div class="fgcolor-orange">' . $text . '</div>';
}
function errorColor($text): string {
  return '<div class="fgcolor-red">' . $text . '</div>';
}
function instantiateColor($text): string {
  return '<div class="bgcolor-blue fgcolor-white">' . $text . '</div>';
}
function violetColor($text): string {
  return '<span class="fgcolor-violet">' . $text . '</span>';
}
function blueColor($text): string {
  return '<span class="fgcolor-blue">' . $text . '</span>';
}
function greenColor($text): string {
  return '<span class="fgcolor-green">' . $text . '</span>';
}
function orangeColor($text): string {
  return '<span class="fgcolor-orange">' . $text . '</span>';
}
function greenWColor($text): string {
  return '<span class="bgcolor-green fgcolor-white">' . $text . '</span>';
}
function orangeWColor($text): string {
  return '<span class="bgcolor-orange fgcolor-white">' . $text . '</span>';
}

function bm_import_theme(): array {
  $module_path = \Drupal::service('extension.path.resolver')
    ->getPath('module', 'bm_import');

  return [
    'bm_import_management_form' => [
      'render element' => 'form', // Crucial for passing the form as a renderable element.
      'template' => 'bm-import-management-form',
      'path' => $module_path . '/templates',
    ],
  ];
}

