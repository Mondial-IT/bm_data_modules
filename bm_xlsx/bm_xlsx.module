function bm_xlsx_help($route_name, RouteMatchInterface $route_match): string {
  if ($route_name == 'help.page.bm_xlsx') {
    $output = '<h2>' . t('Mondial-IT Excel Module') . '</h2>';
    $output .= '<p>' . t('Provides spreadsheet upload helpers, sheet previews, and utility services (BMXLSX) that normalize Excel data for other Blue Marloc modules.') . '</p>';

    $output .= '<h3>' . t('Menus') . '</h3><ul>';
    $output .= '<li>' . t('<strong>bm_xlsx</strong> — link under Blue Marloc » Data production that leads to the settings and demo forms.') . '</li>';
    $output .= '<li>' . t('<strong>Boilerplate</strong> / <strong>Upload and sheet select</strong> — nested demo links for the uploader form.') . '</li>';
    $output .= '</ul>';

    $output .= '<h3>' . t('URIs') . '</h3><ul>';
    $output .= '<li>' . t('<code>@uri</code> (<code>@route</code>) — Configure upload defaults.', [
      '@uri' => '/admin/config/system/bm-xlsx/settings',
      '@route' => 'bm_xlsx.settings_form',
    ]) . '</li>';
    $output .= '<li>' . t('<code>@uri</code> (<code>@route</code>) — Standalone upload + sheet selection form used inside other flows.', [
      '@uri' => '/bm-xlsx/xlsx-upload-and-sheet-select-form',
      '@route' => 'bm_xlsx.excel_upload_and_sheet_select_form',
    ]) . '</li>';
    $output .= '</ul>';

    $output .= '<h3>' . t('BMXLSX helper highlights') . '</h3><ul>';
    $output .= '<li>' . t('<code>getRows()</code> / <code>getRowsKeyed()</code> — Fetch worksheet rows as indexed or keyed arrays.') . '</li>';
    $output .= '<li>' . t('<code>getSheetNames()</code> — Enumerate available worksheets for UI selection.') . '</li>';
    $output .= '<li>' . t('<code>save_as_excel()</code> — Write processed data back to an XLSX file.') . '</li>';
    $output .= '</ul>';

    return $output;
  }
  return "";
}

function bm_xlsx_theme(): array {
  $module_path = \Drupal::service('extension.path.resolver')->getPath('module', 'bm_xlsx');
  return [
    'page__bm_xlsx__xlsx_upload_and_sheet_select_form' => [
      'variables' => [
        'variable1' => NULL,
        'variable2' => NULL,
      ],
      'template' => 'page--bm-xlsx--xlsx-upload-and-sheet-select-form',
      'path' => $module_path . '/templates',
    ],
  ];
}
